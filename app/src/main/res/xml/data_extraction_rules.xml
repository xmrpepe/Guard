<?xml version="1.0" encoding="utf-8"?>
<!-- Settings and rules may be backed up; downloaded lists and caches are excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="stats.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
