<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RocksGuard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/highland_midnight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.RocksGuard.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/highland_midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.RocksGuard</item>
    </style>
</resources>
